.DS_Store
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.env.*
!.env.example

# Original and generated data stay local; retain the directory scaffolding.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Local analytical databases and generated model binaries.
*.duckdb
*.duckdb.wal
*.joblib
*.pkl

# Packaged Tableau workbooks embed generated data; rebuild them from tracked XML/code.
/tableau/*.twbx

# Tableau recovery and lock files are temporary session state.
/tableau/*.twbr
/tableau/.~*
