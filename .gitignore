.DS_Store
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.env.*
!.env.example

# Original and generated data stay local; retain the directory scaffolding.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Local analytical databases and generated model binaries.
*.duckdb
*.duckdb.wal
*.joblib
*.pkl

# Keep working packages local; publish the January portfolio workbook with its data/images.
/tableau/*.twbx
!/tableau/Airline Operations January 2025.twbx

# Tableau recovery and lock files are temporary session state.
/tableau/*.twbr
/tableau/.~*
