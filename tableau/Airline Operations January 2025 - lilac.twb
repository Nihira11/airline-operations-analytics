      <aliases enabled='yes' />
      <column caption='Arrival On-Time Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033811812352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([eligible_arrival_count]) &gt; 0 THEN&#10;    SUM([on_time_arrival_count]) / SUM([eligible_arrival_count])&#10;END' />
      </column>
      <column caption='Cancellation Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033812963329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([scheduled_flight_count]) &gt; 0 THEN&#10;    SUM([cancelled_flight_count]) / SUM([scheduled_flight_count])&#10;END' />
      </column>
      <column caption='Diversion Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033813434370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([scheduled_flight_count]) &gt; 0 THEN&#10;    SUM([diverted_flight_count]) / SUM([scheduled_flight_count])&#10;END' />
      </column>
      <column caption='Origin Reliability Rank' datatype='integer' name='[Calculation_5641033827209219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_5641033811812352], &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Route Delay Rank' datatype='integer' name='[Calculation_5641033829056516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([delayed_arrival_count]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Departure Weekday' datatype='string' name='[Calculation_5641033829855237]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [flight_date])' />
      </column>
      <column caption='Eligible Window Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033829924870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([eligible_arrival_count]) &gt;= 100 THEN&#10;    SUM([on_time_arrival_count]) / SUM([eligible_arrival_count])&#10;END' />
      </column>
      <column caption='Show Eligible Window' datatype='boolean' name='[Calculation_5641033839706119]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(SUM([eligible_arrival_count]), 0) &gt;= 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Arrival Delay Band' datatype='string' name='[Calculation_5641033847791624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_arrival_eligible] THEN&#10;    IF [arrival_delay_minutes] &lt; 0 THEN &quot;1. Early&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 15 THEN &quot;2. On time: 0–14 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 30 THEN &quot;3. Delayed: 15–29 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 60 THEN &quot;4. Delayed: 30–59 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 120 THEN &quot;5. Delayed: 60–119 min&quot;&#10;    ELSE &quot;6. Delayed: 120+ min&quot;&#10;    END&#10;END' />
      </column>
      <column caption='Median Delayed Arrival Minutes' datatype='real' default-format='N' name='[Calculation_5641033851367433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(&#10;    IF [is_arrival_eligible]&#10;       AND [arrival_delay_minutes] &gt;= 15&#10;    THEN [arrival_delay_minutes]&#10;    END&#10;)' />
      </column>
      <column caption='P90 Delayed Arrival Minutes' datatype='real' default-format='N' name='[Calculation_5641033851936778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='PERCENTILE(&#10;    IF [is_arrival_eligible]&#10;       AND [arrival_delay_minutes] &gt;= 15&#10;    THEN [arrival_delay_minutes]&#10;    END,&#10;    0.90&#10;)' />
      </column>
