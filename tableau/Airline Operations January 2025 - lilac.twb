              <groupfilter function='member' level='[none:Calculation_5641033847791624:nk]' member='&quot;2. On time: 0–14 min&quot;' />
              <groupfilter function='member' level='[none:Calculation_5641033847791624:nk]' member='&quot;3. Delayed: 15–29 min&quot;' />
              <groupfilter function='member' level='[none:Calculation_5641033847791624:nk]' member='&quot;4. Delayed: 30–59 min&quot;' />
              <groupfilter function='member' level='[none:Calculation_5641033847791624:nk]' member='&quot;5. Delayed: 60–119 min&quot;' />
