            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#705978' fontname='Arial' fontsize='11' italic='true'>           10 highest delay counts | Minimum 500 eligible arrivals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_flights' name='federated.127rysf1atam781eld5km1r0z3tn' />
