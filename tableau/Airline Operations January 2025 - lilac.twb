          <datasource-dependencies datasource='federated.127rysf1atam781eld5km1r0z3tn'>
            <column caption='Arrival On-Time Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033811812352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([eligible_arrival_count]) &gt; 0 THEN&#10;    SUM([on_time_arrival_count]) / SUM([eligible_arrival_count])&#10;END' />
            </column>
            <column caption='Route Delay Rank' datatype='integer' name='[Calculation_5641033829056516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(SUM([delayed_arrival_count]), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Delayed Arrival Count' datatype='integer' name='[delayed_arrival_count]' role='measure' type='quantitative' />
            <column caption='Destination Airport' datatype='string' name='[destination_airport]' role='dimension' type='nominal' />
            <column caption='Eligible Arrival Count' datatype='integer' name='[eligible_arrival_count]' role='measure' type='quantitative' />
