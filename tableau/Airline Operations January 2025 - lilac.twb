    <worksheet name='Departure Window Reliability'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#392445' fontname='Arial' fontsize='16'>         &lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontsize='10'>Hours reflect scheduled departure time at the origin airport (local time).</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Blank cells have fewer than 100 eligible arrivals.</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Red indicates lower arrival on-time rates; blue indicates higher rates. The colour range adjusts with filters.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_flights' name='federated.127rysf1atam781eld5km1r0z3tn' />
          </datasources>
          <datasource-dependencies datasource='federated.127rysf1atam781eld5km1r0z3tn'>
            <column caption='Departure Weekday' datatype='string' name='[Calculation_5641033829855237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [flight_date])' />
            </column>
            <column caption='Eligible Window Rate' datatype='real' default-format='p0.00%' name='[Calculation_5641033829924870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([eligible_arrival_count]) &gt;= 100 THEN&#10;    SUM([on_time_arrival_count]) / SUM([eligible_arrival_count])&#10;END' />
            </column>
            <column caption='Show Eligible Window' datatype='boolean' name='[Calculation_5641033839706119]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(SUM([eligible_arrival_count]), 0) &gt;= 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Destination Airport' datatype='string' name='[destination_airport]' role='dimension' type='nominal' />
            <column caption='Eligible Arrival Count' datatype='integer' name='[eligible_arrival_count]' role='measure' type='quantitative' />
            <column caption='Flight Date' datatype='date' name='[flight_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5641033829855237]' derivation='None' name='[none:Calculation_5641033829855237:nk]' pivot='key' type='nominal' />
            <column-instance column='[destination_airport]' derivation='None' name='[none:destination_airport:nk]' pivot='key' type='nominal' />
            <column-instance column='[flight_date]' derivation='None' name='[none:flight_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[origin_airport]' derivation='None' name='[none:origin_airport:nk]' pivot='key' type='nominal' />
            <column-instance column='[reporting_airline]' derivation='None' name='[none:reporting_airline:nk]' pivot='key' type='nominal' />
            <column-instance column='[scheduled_departure_hour]' derivation='None' name='[none:scheduled_departure_hour:ok]' pivot='key' type='ordinal' />
            <column caption='On Time Arrival Count' datatype='integer' name='[on_time_arrival_count]' role='measure' type='quantitative' />
            <column caption='Origin Airport' datatype='string' name='[origin_airport]' role='dimension' type='nominal' />
            <column caption='Reporting Airline' datatype='string' name='[reporting_airline]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Scheduled Departure Hour' datatype='integer' name='[scheduled_departure_hour]' role='dimension' type='ordinal' />
            <column-instance column='[eligible_arrival_count]' derivation='Sum' name='[sum:eligible_arrival_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[on_time_arrival_count]' derivation='Sum' name='[sum:on_time_arrival_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5641033829924870]' derivation='User' name='[usr:Calculation_5641033829924870:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5641033839706119]' derivation='User' name='[usr:Calculation_5641033839706119:nk]' pivot='key' type='nominal'>
