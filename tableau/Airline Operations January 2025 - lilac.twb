    <worksheet name='Arrival Delay Severity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#392445' fontname='Arial' fontsize='16'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#705978' fontname='Arial' fontsize='12' italic='true'>All eligible arrivals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_flights' name='federated.127rysf1atam781eld5km1r0z3tn' />
          </datasources>
          <datasource-dependencies datasource='federated.127rysf1atam781eld5km1r0z3tn'>
            <column caption='Arrival Delay Band' datatype='string' name='[Calculation_5641033847791624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_arrival_eligible] THEN&#10;    IF [arrival_delay_minutes] &lt; 0 THEN &quot;1. Early&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 15 THEN &quot;2. On time: 0–14 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 30 THEN &quot;3. Delayed: 15–29 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 60 THEN &quot;4. Delayed: 30–59 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 120 THEN &quot;5. Delayed: 60–119 min&quot;&#10;    ELSE &quot;6. Delayed: 120+ min&quot;&#10;    END&#10;END' />
            </column>
            <column caption='Arrival Delay Minutes' datatype='integer' name='[arrival_delay_minutes]' role='measure' type='quantitative' />
            <column caption='Destination Airport' datatype='string' name='[destination_airport]' role='dimension' type='nominal' />
