            <column caption='Arrival Delay Band' datatype='string' name='[Calculation_5641033847791624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_arrival_eligible] THEN&#10;    IF [arrival_delay_minutes] &lt; 0 THEN &quot;1. Early&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 15 THEN &quot;2. On time: 0–14 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 30 THEN &quot;3. Delayed: 15–29 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 60 THEN &quot;4. Delayed: 30–59 min&quot;&#10;    ELSEIF [arrival_delay_minutes] &lt; 120 THEN &quot;5. Delayed: 60–119 min&quot;&#10;    ELSE &quot;6. Delayed: 120+ min&quot;&#10;    END&#10;END' />
            </column>
