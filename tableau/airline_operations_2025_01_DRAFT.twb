            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <tooltip column="[airline_flights].[sum:cancelled_flight_count:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#246a91"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[airline_flights].[none:reporting_airline:nk]</rows>
        <cols>[airline_flights].[sum:scheduled_flight_count:qk]</cols>
      </table>
      <simple-id uuid="{7714E193-5D4F-5A58-9FAB-3EDEF0E5A600}"/>
    </worksheet>
    <worksheet name="Departure window reliability">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="14" bold="true">Departure window reliability</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="airline_flights" caption="Airline Flights"/>
          </datasources>
          <datasource-dependencies datasource="airline_flights">
            <column name="[flight_id]" caption="Flight Id" datatype="string" role="dimension" type="nominal"/>
            <column name="[flight_date]" caption="Flight Date" datatype="date" role="dimension" type="ordinal"/>
            <column name="[reporting_airline]" caption="Reporting Airline" datatype="string" role="dimension" type="nominal"/>
            <column name="[flight_number]" caption="Flight Number" datatype="string" role="dimension" type="nominal"/>
            <column name="[origin_airport]" caption="Origin Airport" datatype="string" role="dimension" type="nominal"/>
            <column name="[destination_airport]" caption="Destination Airport" datatype="string" role="dimension" type="nominal"/>
            <column name="[route]" caption="Route" datatype="string" role="dimension" type="nominal"/>
            <column name="[scheduled_departure_local]" caption="Scheduled Departure Local" datatype="string" role="dimension" type="nominal"/>
            <column name="[scheduled_departure_hour]" caption="Scheduled Departure Hour" datatype="integer" role="dimension" type="ordinal"/>
            <column name="[scheduled_arrival_local]" caption="Scheduled Arrival Local" datatype="string" role="dimension" type="nominal"/>
            <column name="[scheduled_departure_is_2400]" caption="Scheduled Departure Is 2400" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[scheduled_arrival_is_2400]" caption="Scheduled Arrival Is 2400" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[scheduled_elapsed_minutes]" caption="Scheduled Elapsed Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[distance_miles]" caption="Distance Miles" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[departure_delay_minutes]" caption="Departure Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[arrival_delay_minutes]" caption="Arrival Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[positive_arrival_delay_minutes]" caption="Positive Arrival Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[operation_status]" caption="Operation Status" datatype="string" role="dimension" type="nominal"/>
            <column name="[is_cancelled]" caption="Is Cancelled" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[is_diverted]" caption="Is Diverted" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[is_arrival_eligible]" caption="Is Arrival Eligible" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[arrival_delayed_15]" caption="Arrival Delayed 15" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[has_reported_delay_causes]" caption="Has Reported Delay Causes" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[carrier_delay_minutes]" caption="Carrier Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[weather_delay_minutes]" caption="Weather Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[nas_delay_minutes]" caption="Nas Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[security_delay_minutes]" caption="Security Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[late_aircraft_delay_minutes]" caption="Late Aircraft Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[has_source_quality_issue]" caption="Has Source Quality Issue" datatype="boolean" role="dimension" type="nominal"/>
            <column name="[scheduled_flight_count]" caption="Scheduled Flight Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[cancelled_flight_count]" caption="Cancelled Flight Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[diverted_flight_count]" caption="Diverted Flight Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[eligible_arrival_count]" caption="Eligible Arrival Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[on_time_arrival_count]" caption="On Time Arrival Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[delayed_arrival_count]" caption="Delayed Arrival Count" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[origin_city]" caption="Origin City" datatype="string" role="dimension" type="nominal"/>
            <column name="[origin_state]" caption="Origin State" datatype="string" role="dimension" type="nominal"/>
            <column name="[destination_city]" caption="Destination City" datatype="string" role="dimension" type="nominal"/>
            <column name="[destination_state]" caption="Destination State" datatype="string" role="dimension" type="nominal"/>
            <column name="[Arrival on-time rate]" caption="Arrival on-time rate" datatype="real" role="measure" type="quantitative" default-format="p0.00%">
              <calculation formula="IF SUM([eligible_arrival_count]) &gt; 0 THEN SUM([on_time_arrival_count]) / SUM([eligible_arrival_count]) END" class="tableau"/>
            </column>
            <column name="[Cancellation rate]" caption="Cancellation rate" datatype="real" role="measure" type="quantitative" default-format="p0.00%">
              <calculation formula="IF SUM([scheduled_flight_count]) &gt; 0 THEN SUM([cancelled_flight_count]) / SUM([scheduled_flight_count]) END" class="tableau"/>
            </column>
            <column name="[Diversion rate]" caption="Diversion rate" datatype="real" role="measure" type="quantitative" default-format="p0.00%">
              <calculation formula="IF SUM([scheduled_flight_count]) &gt; 0 THEN SUM([diverted_flight_count]) / SUM([scheduled_flight_count]) END" class="tableau"/>
            </column>
            <column name="[Weekday]" caption="Weekday" datatype="integer" role="dimension" type="ordinal">
              <calculation formula="DATEPART('weekday', [flight_date], 'monday')" class="tableau"/>
            </column>
            <column name="[Window on-time rate (n &gt;= 100)]" caption="Window on-time rate (n &gt;= 100)" datatype="real" role="measure" type="quantitative" default-format="p0.00%">
              <calculation formula="IF SUM([eligible_arrival_count]) &gt;= 100 THEN SUM([on_time_arrival_count]) / SUM([eligible_arrival_count]) END" class="tableau"/>
            </column>
            <column-instance column="[Weekday]" derivation="User" name="[usr:Weekday:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[scheduled_departure_hour]" derivation="None" name="[none:scheduled_departure_hour:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Window on-time rate (n &gt;= 100)]" derivation="User" name="[usr:Window on-time rate (n &gt;= 100):qk]" pivot="key" type="quantitative"/>
            <column-instance column="[eligible_arrival_count]" derivation="Sum" name="[sum:eligible_arrival_count:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Square"/>
            <encodings>
              <color column="[airline_flights].[usr:Window on-time rate (n &gt;= 100):qk]"/>
              <tooltip column="[airline_flights].[sum:eligible_arrival_count:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#246a91"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[airline_flights].[usr:Weekday:ok]</rows>
        <cols>[airline_flights].[none:scheduled_departure_hour:ok]</cols>
      </table>
      <simple-id uuid="{ABA47349-5985-50B7-80D9-1170DB1BB803}"/>
    </worksheet>
    <worksheet name="Reported delay minutes (full January)">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="14" bold="true">Reported delay minutes (full January)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="reported_causes" caption="Reported Causes"/>
          </datasources>
          <datasource-dependencies datasource="reported_causes">
            <column name="[category]" caption="Category" datatype="string" role="dimension" type="nominal"/>
            <column name="[reported_delay_minutes]" caption="Reported Delay Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[flights_with_complete_cause_reporting]" caption="Flights With Complete Cause Reporting" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[flights_with_positive_category_minutes]" caption="Flights With Positive Category Minutes" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/>
            <column name="[share_of_reported_minutes]" caption="Share Of Reported Minutes" datatype="real" role="measure" type="quantitative" default-format="p0.00%"/>
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal"/>
            <column-instance column="[share_of_reported_minutes]" derivation="Avg" name="[avg:share_of_reported_minutes:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[reported_delay_minutes]" derivation="Sum" name="[sum:reported_delay_minutes:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <tooltip column="[reported_causes].[sum:reported_delay_minutes:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#246a91"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[reported_causes].[none:category:nk]</rows>
        <cols>[reported_causes].[avg:share_of_reported_minutes:qk]</cols>
      </table>
      <simple-id uuid="{E2180EF3-E204-59CA-B859-88E5C7E38191}"/>
    </worksheet>
  </worksheets>
