              <calculation formula="IF SUM([scheduled_flight_count]) &gt; 0 THEN SUM([diverted_flight_count]) / SUM([scheduled_flight_count]) END" class="tableau"/>
            </column>
            <column name="[Weekday]" caption="Weekday" datatype="integer" role="dimension" type="ordinal">
              <calculation formula="DATEPART('weekday', [flight_date], 'monday')" class="tableau"/>
            </column>
            <column name="[Window on-time rate (n &gt;= 100)]" caption="Window on-time rate (n &gt;= 100)" datatype="real" role="measure" type="quantitative" default-format="p0.00%">
              <calculation formula="IF SUM([eligible_arrival_count]) &gt;= 100 THEN SUM([on_time_arrival_count]) / SUM([eligible_arrival_count]) END" class="tableau"/>
            </column>
            <column-instance column="[Cancellation rate]" derivation="User" name="[usr:Cancellation rate:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[flight_date]" derivation="None" name="[none:flight_date:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[cancelled_flight_count]" derivation="Sum" name="[sum:cancelled_flight_count:qk]" pivot="key" type="quantitative"/>
